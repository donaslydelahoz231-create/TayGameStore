{
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "mcp__Render__update_environment_variables",
      "mcp__Render__trigger_deploy",
      "mcp__Render__create_web_service",
      "mcp__Render__create_static_site",
      "mcp__Render__create_cron_job",
      "mcp__Render__create_postgres",
      "mcp__Render__create_key_value",
      "mcp__claude-code-remote__create_trigger",
      "mcp__claude-code-remote__update_trigger",
      "mcp__claude-code-remote__delete_trigger",
      "mcp__claude-code-remote__fire_trigger",
      "mcp__github__push_files",
      "mcp__github__create_or_update_file",
      "mcp__github__delete_file",
      "mcp__github__create_branch",
      "mcp__github__merge_pull_request",
      "mcp__github__update_pull_request_branch",
      "mcp__github__enable_pr_auto_merge",
      "mcp__github__actions_run_trigger",
      "mcp__n8n__update_workflow",
      "mcp__n8n__publish_workflow",
      "mcp__n8n__unpublish_workflow",
      "mcp__n8n__archive_workflow"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push --mirror *)",
      "Bash(git filter-repo *)",
      "Bash(git filter-branch *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guardia-datos.sh",
            "timeout": 10,
            "statusMessage": "Guardia de datos"
          }
        ]
      }
    ]
  }
}
