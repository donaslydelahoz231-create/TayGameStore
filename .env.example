# TayGameStore — variables de entorno
# Copia este archivo a `.env` para desarrollo local. `.env` nunca se versiona.
# No escribas secretos reales en este archivo de ejemplo.

# ── Servidor (Fase 0) ─────────────────────────────────────────────
# development | test | production
NODE_ENV=development
# Por defecto: 127.0.0.1 en desarrollo, 0.0.0.0 en producción
HOST=
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Logs legibles (pino-pretty). Por defecto: true solo en desarrollo
LOG_PRETTY=
# Origen público (https obligatorio en producción). Base de cookies, CSRF y OAuth
PUBLIC_BASE_URL=
# "false", "true" o número de proxies de confianza delante de la app
TRUST_PROXY=false

# ── Base de datos ─────────────────────────────────────────────────
# SECRETO. Ej. de formato: postgres://USUARIO:CLAVE@HOST:5432/BASE  (añade ?sslmode=require si el proveedor lo exige)
DATABASE_URL=
DATABASE_POOL_MAX=10
# Solo para `npm run test:integration`. La base DEBE terminar en _test: la prueba borra su esquema
TEST_DATABASE_URL=

# ── Frontend ──────────────────────────────────────────────────────
# Servir el build de Vite desde Fastify. Por defecto: true solo en producción
SERVE_WEB=
WEB_DIST_DIR=dist/web

# ── Interruptores ─────────────────────────────────────────────────
# Solo lecturas; las escrituras responden 503 (los webhooks siguen aceptándose)
MAINTENANCE_MODE=false
# Ventas reales BLOQUEADAS (verificación de jugador y Wompi): en producción debe ser false
CHECKOUT_ENABLED=false
# Pagos no implementados: debe ser false
PAYMENTS_ENABLED=false

# ── Fases posteriores (todavía no se usan; sin valores) ───────────
# Límites antifraude (C6). Valores fijados por el propietario:
# LIMIT_MAX_UNITS_PER_PRODUCT=5
# LIMIT_MAX_ORDER_TOTAL_COP=1000000
# Por definir: LIMIT_MAX_OPEN_ORDERS_PER_EMAIL, LIMIT_MAX_OPEN_ORDERS_PER_UID,
#              RATE_LIMIT_IP_*, RATE_LIMIT_EMAIL_*, RATE_LIMIT_UID_*
# Operación: STORE_TIMEZONE=America/Bogota, STORE_HOURS, DELIVERY_ESTIMATE_MINUTES,
#            VERIFICATION_TTL_MINUTES, PAYMENT_TTL_MINUTES, SUPPORT_WHATSAPP, SUPPORT_EMAIL
# Legal: TERMS_VERSION, PRIVACY_VERSION
# Sesiones: SESSION_TTL_HOURS, SESSION_IDLE_MINUTES, ADMIN_SESSION_TTL_MINUTES
# Secretos (SECRETO): ORDER_TOKEN_PEPPER, IP_HASH_PEPPER, MFA_ENCRYPTION_KEY
# Admin y Google OAuth: ADMIN_EMAILS, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET (SECRETO)
# Entrega: FULFILLMENT_MODE=manual
# CAPTCHA (desactivado): CAPTCHA_ENABLED=false
# Wompi: los nombres se definirán tras verificar la documentación oficial
# Correo: MAIL_* (proveedor por elegir)
