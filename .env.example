# TayGameStore — variables de entorno
# Copia este archivo a `.env` para desarrollo local. `.env` nunca se versiona.
# No escribas secretos reales en este archivo de ejemplo. Los marcados SECRETO van solo en el
# gestor de secretos del hosting (Render → Environment) o en tu .env local.

# ── Servidor ──────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
# Por defecto: 127.0.0.1 en desarrollo, 0.0.0.0 en producción
HOST=
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Logs legibles (pino-pretty). Por defecto: true solo en desarrollo
LOG_PRETTY=
# Origen público. Obligatorio (https) en producción y con pagos: base de cookies, CSRF,
# OAuth, back_urls y notification_url de Mercado Pago. Ej.: https://taygamestore.com
PUBLIC_BASE_URL=
# "false", "true" o número de proxies de confianza delante de la app (Render: 1)
TRUST_PROXY=false

# ── Base de datos ─────────────────────────────────────────────────
# SECRETO. Formato: postgres://USUARIO:CLAVE@HOST:5432/BASE  (?sslmode=require si el proveedor lo exige)
DATABASE_URL=
# SECRETO, opcional. Rol dueño de las tablas solo para migrar; con él, DATABASE_URL usa el rol de
# privilegios mínimos (docs/base-datos-rol-minimo.md). Vacío: las migraciones usan DATABASE_URL.
MIGRATION_DATABASE_URL=
DATABASE_POOL_MAX=10
# Peticiones por minuto y por IP en cualquier ruta (las sensibles tienen límites propios)
RATE_LIMIT_GLOBAL_PER_MINUTE=600
# Solo pruebas. Las bases DEBEN terminar en _test: las pruebas borran su esquema
TEST_DATABASE_URL=
# Opcional: la app de las pruebas usa este rol (empieza por tgs_app) y se crea solo, como en la CI
TEST_APP_DATABASE_URL=
E2E_DATABASE_URL=

# ── Frontend ──────────────────────────────────────────────────────
# Servir el build de Vite desde Fastify. Por defecto: true solo en producción
SERVE_WEB=
WEB_DIST_DIR=dist/web

# ── Interruptores ─────────────────────────────────────────────────
# Solo lecturas; las escrituras responden 503 (los webhooks siguen aceptándose)
MAINTENANCE_MODE=false
# Permite crear pedidos. En producción exige un método de pago activo: PAYMENTS_ENABLED=true
# (Mercado Pago) o NEQUI_MANUAL_ENABLED=true (Nequi por transferencia), o ambos
CHECKOUT_ENABLED=false
# Pagos con Mercado Pago. Exige MP_ACCESS_TOKEN, MP_WEBHOOK_SECRET y PUBLIC_BASE_URL.
# No afecta a Nequi (sección «Nequi por transferencia»)
PAYMENTS_ENABLED=false
# Pausa las entregas desde el panel (los pagos se siguen registrando)
FULFILLMENT_ENABLED=true
# Único modo disponible hasta tener un proveedor de recargas legítimo
FULFILLMENT_MODE=manual
# Tareas programadas (expiración, conciliación, limpieza). Por defecto: true salvo en test
JOBS_ENABLED=
# Modo reposo: sin visitas a la API durante estos minutos, las tareas corren una vez por
# intervalo y la base de datos puede suspenderse (ahorra horas de cómputo de Neon). 0 = desactivado
JOBS_IDLE_MINUTES=30
# Cuánto espera una petición (pago, «Ya transferí», panel) a sus avisos (correo, hoja, webhook)
# antes de responder; lo demás sigue en segundo plano y la cola lo reintenta (0–30000 ms)
NOTIFY_INLINE_WAIT_MS=300

# ── Claves de la aplicación (SECRETO; obligatorias en producción) ─
# Llaveros versionados "versión:claveBase64" (mín. 32 bytes). La PRIMERA es la activa;
# las siguientes solo verifican/descifran datos antiguos (rotación sin cortar el servicio).
# Generar: node -e "console.log('1:'+require('crypto').randomBytes(32).toString('base64'))"
ORDER_TOKEN_KEYS=
MFA_ENCRYPTION_KEYS=
# Pepper para el hash de IPs (mín. 32 caracteres)
IP_HASH_PEPPER=

# ── Sesiones ──────────────────────────────────────────────────────
SESSION_TTL_HOURS=168
SESSION_IDLE_MINUTES=1440
ADMIN_SESSION_TTL_MINUTES=120

# ── Google OAuth / OIDC (cliente "Aplicación web") ────────────────
# URI de redirección autorizada: <PUBLIC_BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
# SECRETO
GOOGLE_CLIENT_SECRET=
# Correos con acceso al panel /admin.html (separados por coma). Requiere Google configurado
ADMIN_EMAILS=

# ── Login de CLIENTES con Facebook (opcional; nunca da acceso de admin) ──
# Facebook: https://developers.facebook.com/apps → Inicio de sesión con Facebook. Redirección:
#   <PUBLIC_BASE_URL>/auth/facebook/callback
FACEBOOK_APP_ID=
# SECRETO
FACEBOOK_APP_SECRET=
# Versión de la Graph API (comprobar la vigente en el panel de Meta)
FACEBOOK_GRAPH_VERSION=v25.0

# ── Mercado Pago (Checkout Pro) ───────────────────────────────────
# SECRETO. Access token de la aplicación (credenciales de prueba primero; luego producción)
MP_ACCESS_TOKEN=
# SECRETO. "Clave secreta" de Webhooks (Tus integraciones → Webhooks) para validar x-signature
MP_WEBHOOK_SECRET=
# Texto en el extracto de la tarjeta (opcional, letras/números/espacios, máx. 22)
MP_STATEMENT_DESCRIPTOR=
MP_TIMEOUT_MS=10000
# Cuenta declarada: sandbox (cuenta vendedora de PRUEBA) o production. Obligatoria con pagos.
# Las credenciales de prueba también empiezan por APP_USR: no se deduce del token. El servidor
# compara este valor con live_mode de cada pago; si no coincide, el pedido va a revisión.
MP_MODE=sandbox

# ── Nequi por transferencia (independiente de Mercado Pago) ──────
# Ninguna variable de Mercado Pago sirve para Nequi ni al revés. Guía: docs/pagos-nequi.md
# Apagado por defecto. Activarlo publica la llave y/o el celular a cada comprador que elige
# Nequi en su pedido: es decisión del dueño (docs/datos-del-propietario.md, requisito 19).
# Hace falta al menos uno de los dos: NEQUI_MANUAL_BREB_KEY o NEQUI_MANUAL_PHONE.
NEQUI_MANUAL_ENABLED=false
# Llave Bre-B alfanumérica de la cuenta que recibe: empieza por @. Solo números no (una llave
# con el número de documento nunca se publica), salvo @ + celular de 10 dígitos que empieza por 3.
# Ej. ficticios: @tiendaprueba o @3001234567
NEQUI_MANUAL_BREB_KEY=
# Celular de la cuenta Nequi que recibe (opcional con llave; 10 dígitos, empieza por 3).
# Ej. ficticio: 3001234567
NEQUI_MANUAL_PHONE=
# Titular que ve el comprador para comprobarlo antes de enviar (recomendado; solo letras,
# espacios y puntos)
NEQUI_MANUAL_HOLDER=
# Horas que el pedido sigue abierto tras el aviso «Ya transferí», para verificar (1–72)
NEQUI_MANUAL_REVIEW_HOURS=24
# Nequi Push (API oficial) NO tiene variables: no hay acceso oficial ni se implementa.

# ── Pedidos y antifraude ──────────────────────────────────────────
# Tiempo para que el equipo verifique el jugador y para pagar tras confirmar
VERIFICATION_TTL_MINUTES=720
PAYMENT_TTL_MINUTES=60
# Un reclamo de entrega sin iniciar se libera tras este tiempo
CLAIM_TIMEOUT_MINUTES=30
# Límites del propietario (no se pueden subir por encima de 5 y 1.000.000)
LIMIT_MAX_UNITS_PER_PRODUCT=5
LIMIT_MAX_ORDER_TOTAL_COP=1000000
LIMIT_MAX_OPEN_ORDERS_PER_EMAIL=3
LIMIT_MAX_OPEN_ORDERS_PER_UID=3

# ── Tienda ────────────────────────────────────────────────────────
# Versión de términos que el cliente acepta (cámbiala al modificar los términos)
TERMS_VERSION=2026-10-05
# Canales de soporte mostrados en la tienda
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=

# Frase de activación del dueño (SECRETO, mínimo 20 caracteres): crear su contraseña y su
# primera huella en el panel. Deja de servir cuando ya existen. Ver docs/acceso-administrador.md
ADMIN_SETUP_CODE=

# Huella o llave de acceso del administrador: por defecto usa el dominio de PUBLIC_BASE_URL.
# Solo para pruebas locales en otra dirección: PASSKEY_RP_ID=localhost y PASSKEY_ORIGIN=http://localhost:4173
PASSKEY_RP_ID=
PASSKEY_ORIGIN=

# Precio promocional de los productos: weekends (sábado y domingo, hora de Colombia; valor por
# defecto) o always (mientras el producto tenga promoción vigente).
PROMO_SCHEDULE=weekends

# Política de ganancia con proveedor (docs/proveedor-recargas/FINANZAS.md): comisión del pago en %
# del precio, cargo fijo por pago en pesos e IVA sobre la comisión en %, y ganancia mínima sobre el
# costo. Mercado Pago Colombia publica 3,29 % + $800 + IVA (dinero al instante): confírmalo en tu
# panel. Con cargo fijo e IVA en 0 se calcula solo con el porcentaje.
PAYMENT_FEE_PCT=4
PAYMENT_FEE_FIXED_COP=0
PAYMENT_FEE_TAX_PCT=0
MIN_MARGIN_PCT=5

# Sin proveedor de consulta de ID: customer (por defecto; el cliente escribe su ID dos veces,
# lo confirma y paga al instante, como en LootBar) u operator (el equipo verifica el nickname
# antes de que el cliente pueda pagar).
PLAYER_VERIFICATION=customer

# Entrega automática con el inventario: al aprobarse el pago, si hay PIN para todas las unidades,
# el pedido queda entregado y el cliente ve sus PIN (pedido y correo) para canjearlos en
# pagostore.com. Sin PIN suficientes se entrega a mano. Por defecto false.
PIN_AUTO_DELIVERY=false

# Datos del vendedor en términos y privacidad (una línea cada uno). Se escriben en el hosting:
# la tienda los pone en /terminos.html y /privacidad.html al servirlas y no vende en
# producción mientras falte alguno. Plazos e impuestos: decídelos con tu contador o abogado.
LEGAL_NAME=            # nombre o razón social
LEGAL_ID=              # SOLO los 4 últimos dígitos del documento (nunca el completo)
LEGAL_ADDRESS=         # dirección y ciudad
LEGAL_DELIVERY_TIME=   # plazo de entrega de la recarga
LEGAL_REFUND_TIME=     # plazo de reembolso si no se puede entregar
LEGAL_RESPONSE_TIME=   # plazo de respuesta a peticiones y reclamos
LEGAL_TAX_NOTE=        # frase sobre IVA u otros impuestos en los precios
LEGAL_RETENTION=       # tiempo que se conservan pedidos y pagos

# ── Registro auxiliar en Google Sheets (opcional) ─────────────────
# Copia de los pedidos pagados en una hoja tuya. Pestaña «Pedidos»: sin correos, nombres, UID ni
# PIN. Pestaña «Entregas»: además ID, nickname, servidor y región del jugador (nunca correo,
# nombre ni PIN). Nunca es la fuente de verdad: editar la hoja no cambia ningún pedido. Cuenta de
# servicio de Google Cloud con la hoja compartida con su correo (Editor). Nunca en Git.
# Si algo falta o está mal, la hoja se apaga y la tienda sigue. Guía: docs/google-sheets.md
GOOGLE_SHEETS_SPREADSHEET_ID=
# Lo más simple: el archivo JSON de la llave completo, pegado tal cual (Google Cloud → cuenta de
# servicio → Claves → Agregar clave → JSON). O, en su lugar, correo + llave por separado:
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
# Pestañas donde se agregan las filas (por defecto Pedidos, Entregas, Pagos pendientes y
# Usuarios; deben ser distintas). «Pagos pendientes»: pedidos Nequi, lo que el cliente debe y lo
# que avisó. «Usuarios»: el nombre de usuario de cada cliente (nunca correo ni nombre real).
GOOGLE_SHEETS_TAB=Pedidos
GOOGLE_SHEETS_DELIVERY_TAB=Entregas
GOOGLE_SHEETS_PENDING_TAB=Pagos pendientes
GOOGLE_SHEETS_USERS_TAB=Usuarios

# ── Automatización con n8n (opcional) ─────────────────────────────
# Cada pedido pagado, entregado o reembolsado se envía (POST JSON) al Webhook del flujo
# "TayGameStore · Pedidos" de n8n. URL de producción del Webhook (https) y una llave aleatoria
# de 32+ caracteres; en n8n la misma llave va en la credencial "Header Auth" como
# "Bearer <llave>". Van juntas. Nunca en Git. Guía: docs/n8n.md
EVENTS_WEBHOOK_URL=
EVENTS_WEBHOOK_SECRET=
# false apaga los eventos sin borrar la URL ni la llave (p. ej. al dejar n8n). Por defecto true.
EVENTS_WEBHOOK_ENABLED=true

# ── Correo (opcional, recomendado) ────────────────────────────────
# Al cliente: "Pago confirmado", "Recarga completada" y "Reembolso registrado".
# Al dueño (ADMIN_EMAILS): "Pedido pagado por entregar". Solo tras un pago confirmado.
# Es el único aviso al dueño fuera del panel: Telegram no se usa (decisión del dueño).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=tu cuenta y SMTP_PASS una
# "contraseña de aplicación" (requiere verificación en dos pasos). Nunca tu contraseña normal.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Remitente (por defecto SMTP_USER) y nombre visible
MAIL_FROM=
MAIL_FROM_NAME=TayGameStore
