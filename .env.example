# TayGameStore — variables de entorno
# Copia este archivo a `.env` para desarrollo local. `.env` nunca se versiona.
# No escribas secretos reales en este archivo de ejemplo. Los marcados SECRETO van solo en el
# gestor de secretos del hosting (Render → Environment) o en tu .env local.

# ── Servidor ──────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
# Por defecto: 127.0.0.1 en desarrollo, 0.0.0.0 en producción
HOST=
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Logs legibles (pino-pretty). Por defecto: true solo en desarrollo
LOG_PRETTY=
# Origen público. Obligatorio (https) en producción y con pagos: base de cookies, CSRF,
# OAuth, back_urls y notification_url de Mercado Pago. Ej.: https://taygamestore.com
PUBLIC_BASE_URL=
# "false", "true" o número de proxies de confianza delante de la app (Render: 1)
TRUST_PROXY=false

# ── Base de datos ─────────────────────────────────────────────────
# SECRETO. Formato: postgres://USUARIO:CLAVE@HOST:5432/BASE  (?sslmode=require si el proveedor lo exige)
DATABASE_URL=
DATABASE_POOL_MAX=10
# Peticiones por minuto y por IP en cualquier ruta (las sensibles tienen límites propios)
RATE_LIMIT_GLOBAL_PER_MINUTE=600
# Solo pruebas. Las bases DEBEN terminar en _test: las pruebas borran su esquema
TEST_DATABASE_URL=
E2E_DATABASE_URL=

# ── Frontend ──────────────────────────────────────────────────────
# Servir el build de Vite desde Fastify. Por defecto: true solo en producción
SERVE_WEB=
WEB_DIST_DIR=dist/web

# ── Interruptores ─────────────────────────────────────────────────
# Solo lecturas; las escrituras responden 503 (los webhooks siguen aceptándose)
MAINTENANCE_MODE=false
# Permite crear pedidos. En producción exige PAYMENTS_ENABLED=true
CHECKOUT_ENABLED=false
# Pagos con Mercado Pago. Exige MP_ACCESS_TOKEN, MP_WEBHOOK_SECRET y PUBLIC_BASE_URL
PAYMENTS_ENABLED=false
# Pausa las entregas desde el panel (los pagos se siguen registrando)
FULFILLMENT_ENABLED=true
# Único modo disponible hasta tener un proveedor de recargas legítimo
FULFILLMENT_MODE=manual
# Tareas programadas (expiración, conciliación, limpieza). Por defecto: true salvo en test
JOBS_ENABLED=

# ── Claves de la aplicación (SECRETO; obligatorias en producción) ─
# Llaveros versionados "versión:claveBase64" (mín. 32 bytes). La PRIMERA es la activa;
# las siguientes solo verifican/descifran datos antiguos (rotación sin cortar el servicio).
# Generar: node -e "console.log('1:'+require('crypto').randomBytes(32).toString('base64'))"
ORDER_TOKEN_KEYS=
MFA_ENCRYPTION_KEYS=
# Pepper para el hash de IPs (mín. 32 caracteres)
IP_HASH_PEPPER=

# ── Sesiones ──────────────────────────────────────────────────────
SESSION_TTL_HOURS=168
SESSION_IDLE_MINUTES=1440
ADMIN_SESSION_TTL_MINUTES=120

# ── Google OAuth / OIDC (cliente "Aplicación web") ────────────────
# URI de redirección autorizada: <PUBLIC_BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
# SECRETO
GOOGLE_CLIENT_SECRET=
# Correos con acceso al panel /admin.html (separados por coma). Requiere Google configurado
ADMIN_EMAILS=

# ── Login de CLIENTES con Discord y Facebook (opcionales; nunca dan acceso de admin) ──
# Discord: https://discord.com/developers/applications → OAuth2. Redirección:
#   <PUBLIC_BASE_URL>/auth/discord/callback
DISCORD_CLIENT_ID=
# SECRETO
DISCORD_CLIENT_SECRET=
# Facebook: https://developers.facebook.com/apps → Inicio de sesión con Facebook. Redirección:
#   <PUBLIC_BASE_URL>/auth/facebook/callback
FACEBOOK_APP_ID=
# SECRETO
FACEBOOK_APP_SECRET=
# Versión de la Graph API (comprobar la vigente en el panel de Meta)
FACEBOOK_GRAPH_VERSION=v25.0

# ── Mercado Pago (Checkout Pro) ───────────────────────────────────
# SECRETO. Access token de la aplicación (credenciales de prueba primero; luego producción)
MP_ACCESS_TOKEN=
# SECRETO. "Clave secreta" de Webhooks (Tus integraciones → Webhooks) para validar x-signature
MP_WEBHOOK_SECRET=
# Texto en el extracto de la tarjeta (opcional, letras/números/espacios, máx. 22)
MP_STATEMENT_DESCRIPTOR=
MP_TIMEOUT_MS=10000
# Cuenta declarada: sandbox (cuenta vendedora de PRUEBA) o production. Obligatoria con pagos.
# Las credenciales de prueba también empiezan por APP_USR: no se deduce del token. El servidor
# compara este valor con live_mode de cada pago; si no coincide, el pedido va a revisión.
MP_MODE=sandbox

# ── Pedidos y antifraude ──────────────────────────────────────────
# Tiempo para que el equipo verifique el jugador y para pagar tras confirmar
VERIFICATION_TTL_MINUTES=720
PAYMENT_TTL_MINUTES=60
# Un reclamo de entrega sin iniciar se libera tras este tiempo
CLAIM_TIMEOUT_MINUTES=30
# Límites del propietario (no se pueden subir por encima de 5 y 1.000.000)
LIMIT_MAX_UNITS_PER_PRODUCT=5
LIMIT_MAX_ORDER_TOTAL_COP=1000000
LIMIT_MAX_OPEN_ORDERS_PER_EMAIL=3
LIMIT_MAX_OPEN_ORDERS_PER_UID=3

# ── Tienda ────────────────────────────────────────────────────────
# Versión de términos que el cliente acepta (cámbiala al modificar los términos)
TERMS_VERSION=2026-10-05
# Canales de soporte mostrados en la tienda
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=

# Datos del vendedor en términos y privacidad (una línea cada uno). Se escriben en el hosting:
# la tienda los pone en /terminos.html y /privacidad.html al servirlas y no vende en
# producción mientras falte alguno. Plazos e impuestos: decídelos con tu contador o abogado.
LEGAL_NAME=            # nombre o razón social
LEGAL_ID=              # NIT o cédula
LEGAL_ADDRESS=         # dirección y ciudad
LEGAL_DELIVERY_TIME=   # plazo de entrega de la recarga
LEGAL_REFUND_TIME=     # plazo de reembolso si no se puede entregar
LEGAL_RESPONSE_TIME=   # plazo de respuesta a peticiones y reclamos
LEGAL_TAX_NOTE=        # frase sobre IVA u otros impuestos en los precios
LEGAL_RETENTION=       # tiempo que se conservan pedidos y pagos

# ── Aviso al dueño (opcional) ─────────────────────────────────────
# Mensaje de Telegram cuando Mercado Pago confirma un pago (para entregar enseguida).
# Bot creado con @BotFather; chat: tu id numérico o @canal. Van juntos. Nunca en Git.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Automatización con n8n (opcional) ─────────────────────────────
# Cada pedido pagado, entregado o reembolsado se envía (POST JSON) al Webhook del flujo
# "TayGameStore · Pedidos" de n8n. URL de producción del Webhook (https) y una llave aleatoria
# de 32+ caracteres; en n8n la misma llave va en la credencial "Header Auth" como
# "Bearer <llave>". Van juntas. Nunca en Git. Guía: docs/n8n.md
EVENTS_WEBHOOK_URL=
EVENTS_WEBHOOK_SECRET=

# ── Correo (opcional, recomendado) ────────────────────────────────
# Al cliente: "Pago confirmado", "Recarga completada" y "Reembolso registrado".
# Al dueño (ADMIN_EMAILS): "Pedido pagado por entregar". Solo tras un pago confirmado.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=tu cuenta y SMTP_PASS una
# "contraseña de aplicación" (requiere verificación en dos pasos). Nunca tu contraseña normal.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Remitente (por defecto SMTP_USER) y nombre visible
MAIL_FROM=
MAIL_FROM_NAME=TayGameStore
