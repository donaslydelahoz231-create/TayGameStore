      "id": "3e2c0fcf-9892-4b39-bb6c-962c4ff871fc",
      "name": "Leer latidos y estados",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [1168, 128],
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "tienda",
              "name": "tienda",
              "value": "={{ (() => { const r = $(\"Tienda · estado\").first().json; return r.statusCode === 200 && r.body?.status === \"ready\" ? \"OK: tienda y base de datos responden\" : \"FALLA: \" + (r.statusCode ? \"HTTP \" + r.statusCode + \" \" + JSON.stringify(r.body ?? {}).slice(0, 120) : \"sin respuesta (\" + String(r.error?.message ?? r.error ?? \"desconocido\").slice(0, 120) + \")\"); })() }}",
              "type": "string"
            },
            {
              "id": "catalogo",
              "name": "catalogo",
              "value": "={{ (() => { const n = ($(\"Tienda · catálogo\").first().json.products ?? []).length; return n > 0 ? \"OK: \" + n + \" paquetes activos\" : \"FALLA: el catálogo está vacío o no responde\"; })() }}",
              "type": "string"
            },
            {
              "id": "compras",
              "name": "compras",
              "value": "={{ (() => { const c = $(\"Tienda · configuración\").first().json; if (c.maintenanceMode) return \"PENDIENTE: la tienda está en mantenimiento\"; if (c.checkoutEnabled && c.paymentsEnabled) return c.paymentsMode === \"sandbox\" ? \"PENDIENTE: pagos en modo de PRUEBA (sandbox)\" : \"OK: compras y pagos activos\"; return \"PENDIENTE: compras/pagos apagados (faltan credenciales de Mercado Pago y textos legales)\"; })() }}",
              "type": "string"
            },
            {
              "id": "login",
              "name": "login",
              "value": "={{ $(\"Tienda · configuración\").first().json.auth?.google ? \"OK: acceso con Google activo\" : \"PENDIENTE: configurar Google OAuth (GOOGLE_CLIENT_ID/SECRET y ADMIN_EMAILS en Render)\" }}",
              "type": "string"
            },
            {
              "id": "correos",
              "name": "correos",
              "value": "={{ $(\"Tienda · configuración\").first().json.emailUpdates ? \"OK: correos a clientes activos\" : \"PENDIENTE: correo de la tienda (SMTP_PASS en Render)\" }}",
              "type": "string"
            },
            {
              "id": "soporte",
              "name": "soporte",
              "value": "={{ (() => { const s = $(\"Tienda · configuración\").first().json.support ?? {}; return s.whatsapp || s.email ? \"OK: WhatsApp \" + (s.whatsapp ? \"+\" + s.whatsapp : \"—\") + \" · \" + (s.email ?? \"—\") : \"PENDIENTE: canales de soporte\"; })() }}",
              "type": "string"
            },
            {
              "id": "verificacionId",
              "name": "verificacionId",
              "value": "={{ $(\"Tienda · configuración\").first().json.playerLookup ? \"OK: consulta automática de ID activa\" : \"OK (manual): el dueño verifica ID, nickname y región desde el panel\" }}",
              "type": "string"
            },
            {
              "id": "pedidosN8n",
              "name": "pedidosN8n",
              "value": "={{ (() => { const w = $(\"n8n · webhook de Pedidos\").first().json; if (w.statusCode === 403 || w.statusCode === 401) return \"OK: webhook de Pedidos activo y protegido con llave\"; if (w.statusCode === 404) return \"PENDIENTE: publicar el flujo Pedidos (credenciales)\"; return \"REVISAR: el webhook de Pedidos respondió \" + (w.statusCode ?? \"sin respuesta\"); })() }}",
              "type": "string"
            },
            {
              "id": "tareas",
              "name": "tareas",
              "value": "={{ (() => { const r = $(\"Leer latidos y estados\").all().map(i => i.json).find(x => x.comprobacion === \"tareas\"); if (!r) return \"OK (interno): la tienda ejecuta sus tareas con su programador interno; el respaldo de n8n está sin publicar\"; const min = Math.round(($now.toMillis() - DateTime.fromISO(String(r.cambioEn)).toMillis()) / 60000); return r.ok && min <= 25 ? \"OK: última ejecución hace \" + min + \" min\" : \"FALLA: \" + (r.ok ? \"sin ejecutarse hace \" + min + \" min\" : String(r.detalle ?? \"\").slice(0, 150)); })() }}",
              "type": "string"
            },
            {
              "id": "vigilancia",
              "name": "vigilancia",
              "value": "={{ (() => { const r = $(\"Leer latidos y estados\").all().map(i => i.json).find(x => x.comprobacion === \"vigilancia\"); if (!r) return \"PENDIENTE: la vigilancia aún no registra latidos\"; const min = Math.round(($now.toMillis() - DateTime.fromISO(String(r.cambioEn)).toMillis()) / 60000); return min <= 15 ? \"OK: última revisión hace \" + min + \" min\" : \"FALLA: sin revisar hace \" + min + \" min\"; })() }}",
              "type": "string"
            },
            {
              "id": "revisadoEn",
              "name": "revisadoEn",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "5bbb722d-ec31-4f11-b533-05c356028997",
      "name": "Evaluar el sistema",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [800, 128],
      "executeOnce": true
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "fallas",
              "name": "fallas",
              "value": "={{ [\"tienda\",\"catalogo\",\"compras\",\"login\",\"correos\",\"soporte\",\"verificacionId\",\"pedidosN8n\",\"tareas\",\"vigilancia\"].filter(k => /^(FALLA|REVISAR)/.test($json[k])).length }}",
              "type": "number"
            },
            {
              "id": "pendientes",
              "name": "pendientes",
              "value": "={{ [\"tienda\",\"catalogo\",\"compras\",\"login\",\"correos\",\"soporte\",\"verificacionId\",\"pedidosN8n\",\"tareas\",\"vigilancia\"].filter(k => /^PENDIENTE/.test($json[k])).length }}",
              "type": "number"
            },
            {
              "id": "ok",
              "name": "ok",
              "value": "={{ ![\"tienda\",\"catalogo\",\"compras\",\"login\",\"correos\",\"soporte\",\"verificacionId\",\"pedidosN8n\",\"tareas\",\"vigilancia\"].some(k => /^(FALLA|REVISAR)/.test($json[k])) }}",
              "type": "boolean"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "5fee28f8-42b5-49ce-9ff8-2093e6474c82",
      "name": "Resumir diagnóstico",
