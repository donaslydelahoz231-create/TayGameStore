{
  "id": "S1NuGJNsbVpSP6aG",
  "name": "TayGameStore · Errores",
  "description": "Flujo de error central: cuando Tareas, Vigilancia o Pedidos fallan en producción, lo anota en Incidentes y avisa por Gmail con el enlace a la ejecución.",
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "availableInMCP": true,
    "timezone": "America/Bogota",
    "binaryMode": "separate"
  },
  "nodes": [
    {
      "id": "022c8013-f01a-41e1-93e1-bffdc7926328",
      "name": "Cuando un flujo falla",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "parameters": {}
    },
    {
      "id": "6a0442a9-4828-4209-8067-0feef01d5970",
      "name": "Describir el fallo",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [272, 128],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "flujo",
              "name": "flujo",
              "value": "={{ $json.workflow?.name ?? \"Flujo desconocido\" }}",
              "type": "string"
            },
            {
              "id": "comprobacion",
              "name": "comprobacion",
              "value": "={{ \"Falló en: \" + ($json.execution?.lastNodeExecuted ?? \"nodo desconocido\") }}",
              "type": "string"
            },
            {
              "id": "detalle",
              "name": "detalle",
              "value": "={{ String($json.execution?.error?.message ?? $json.trigger?.error?.message ?? \"sin detalle\").slice(0, 400) }}",
              "type": "string"
            },
            {
              "id": "enlace",
              "name": "enlace",
              "value": "={{ $json.execution?.url ?? \"\" }}",
              "type": "string"
            },
            {
              "id": "ocurrioEn",
              "name": "ocurrioEn",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "3d489d90-0e65-4ba8-a8d4-10bd95f3f229",
