        "message": "=El flujo \"{{ $(\"Describir el fallo\").item.json.flujo }}\" falló.\n\n{{ $(\"Describir el fallo\").item.json.comprobacion }}\nDetalle: {{ $(\"Describir el fallo\").item.json.detalle }}\nEjecución: {{ $(\"Describir el fallo\").item.json.enlace }}\n\nSi era un evento de la tienda, la tienda lo reintentará sola. Revisa la ejecución si el aviso se repite.",
        "options": {
          "appendAttribution": false
        }
      },
      "onError": "continueRegularOutput",
      "webhookId": "eeae7269-22e0-4343-9f82-5ef25556680a",
