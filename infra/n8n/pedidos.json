            },
            {
              "id": "etapa",
              "name": "etapa",
              "value": "={{ ({ AWAITING_VERIFICATION: \"1 · Por verificar ID\", AWAITING_PAYMENT: \"2 · Esperando pago\", PAID: \"3 · Pagado: por entregar\", DELIVERING: \"3 · Entregando\", NEEDS_REVIEW: \"! Revisar en el panel\", DELIVERED: \"4 · Entregado\", REFUNDED: \"✕ Reembolsado\", REJECTED: \"✕ Rechazado\", EXPIRED: \"✕ Vencido\" })[$json.body?.order?.status] ?? String($json.body?.order?.status ?? \"\") }}",
              "type": "string"
            },
            {
              "id": "totalCop",
              "name": "totalCop",
              "value": "={{ Number($json.body?.order?.totalCop ?? 0) }}",
              "type": "number"
            },
            {
