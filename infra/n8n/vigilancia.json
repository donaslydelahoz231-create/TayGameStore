{
  "id": "wOqFUIwk4GEINrVc",
  "name": "TayGameStore · Vigilancia cada 5 min",
  "description": "Cada 5 min consulta /api/health (y /api/ready una vez por hora, para que Neon pueda dormir). Solo si la tienda cae o se recupera (confirmado a los 90 s): guarda el estado, registra incidente y avisa por Gmail.",
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "availableInMCP": true,
    "timezone": "America/Bogota",
    "errorWorkflow": "S1NuGJNsbVpSP6aG",
    "binaryMode": "separate",
    "timeSavedMode": "fixed",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "nodes": [
    {
      "id": "ed906746-3fdf-4674-bf41-4e0e5f283626",
      "name": "Cada 5 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [0, 192],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        },
        "misfirePolicy": "skip"
      }
    },
    {
      "id": "13ae133e-97ba-4cea-9ef1-ec79262f2e20",
      "name": "Consultar estado de la tienda",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [272, 320],
      "parameters": {
        "method": "GET",
        "url": "={{ \"https://taygamestore.onrender.com\" + ($now.setZone(\"America/Bogota\").minute < 5 ? \"/api/ready\" : \"/api/health\") }}",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "id": "35b6e5cc-e861-461f-bd1d-85c96d4985ea",
      "name": "Resumir resultado",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [496, 320],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "ok",
              "name": "ok",
              "value": "={{ $json.statusCode === 200 && [\"ready\", \"ok\"].includes($json.body?.status) }}",
              "type": "boolean"
            },
            {
              "id": "detalle",
              "name": "detalle",
              "value": "={{ $json.statusCode ? (\"HTTP \" + $json.statusCode + \" \" + JSON.stringify($json.body ?? {})).slice(0, 300) : (\"Sin respuesta: \" + String($json.error?.message ?? $json.error ?? \"desconocido\")).slice(0, 300) }}",
              "type": "string"
            },
            {
              "id": "revisadoEn",
              "name": "revisadoEn",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "9a400848-c7c7-4976-aecc-6fb9e11d5983",
      "name": "Leer estado anterior",
