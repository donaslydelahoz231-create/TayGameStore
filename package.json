{
  "name": "taygamestore",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "TayGameStore — tienda de recargas gamer (frontend cinematográfico + API).",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.build.json",
    "build:preview": "node tools/preview/build.mjs",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run tests/unit tests/api",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "test:e2e": "playwright test e2e/behavior.spec.ts e2e/quality.spec.ts e2e/tampering.spec.ts e2e/motion.spec.ts --project=desktop-1280",
    "load:server": "npm run build && node --import tsx e2e/support/server.ts",
    "load:sim": "node tools/load/simulate.mjs",
    "test:visual": "playwright test e2e/visual.spec.ts",
    "test:visual:update": "playwright test e2e/visual.spec.ts --update-snapshots",
    "perf:api": "node --import tsx tests/perf/api-load.bench.ts",
    "perf:orders": "node --import tsx tests/perf/orders-list.bench.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/server/db/migrate.ts",
    "db:migrate:prod": "node dist/server/db/migrate.js",
    "golive:check": "node --env-file-if-exists=.env --import tsx src/server/cli/golive-main.ts",
    "mp:sandbox": "node --env-file-if-exists=.env --import tsx src/server/cli/mp-sandbox-main.ts",
    "unipin:check": "node --env-file-if-exists=.env --import tsx src/server/cli/unipin-check-main.ts",
    "finanzas:margenes": "node --import tsx src/server/cli/finanzas-main.ts",
    "db:seed:dev": "node --env-file-if-exists=.env --import tsx src/server/db/seed-dev.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "mercadopago": "3.6.1",
    "nodemailer": "10.1.7",
    "pg": "8.23.1",
    "qrcode-generator": "2.0.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/smtp-server": "3.5.13",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "smtp-server": "3.19.23",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    }
  }
}
