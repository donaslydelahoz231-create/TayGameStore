{
  "name": "taygamestore",
  "version": "0.0.0",
  "private": true,
  "description": "TayGameStore — tienda de recargas gamer (frontend cinematográfico + API).",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run tests/unit tests/api",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "test:e2e": "playwright test e2e/behavior.spec.ts e2e/quality.spec.ts --project=desktop-1280",
    "test:visual": "playwright test e2e/visual.spec.ts",
    "test:visual:update": "playwright test e2e/visual.spec.ts --update-snapshots",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/server/db/migrate.ts",
    "db:migrate:prod": "node dist/server/db/migrate.js",
    "mp:sandbox": "node --env-file-if-exists=.env --import tsx src/server/cli/mp-sandbox-main.ts",
    "db:seed:dev": "node --env-file-if-exists=.env --import tsx src/server/db/seed-dev.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.5",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "mercadopago": "3.6.1",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
